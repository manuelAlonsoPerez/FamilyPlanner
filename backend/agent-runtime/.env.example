APP_ENV=development
LOG_LEVEL=INFO

# Frankfurt supports AgentCore Runtime. The EU inference profile keeps
# Nova Micro inference within its documented EU destination regions.
AWS_REGION=eu-central-1
AWS_PROFILE=family-planner-dev
BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0

# Conservative defaults for low-cost local development.
AGENT_MAX_STEPS=6
AGENT_REQUEST_TIMEOUT_SECONDS=45
AGENT_CONTEXT_MESSAGE_LIMIT=20
AGENT_MAX_OUTPUT_TOKENS=1024
